# Bazel build configuration for NXP MWIFIEX WiFi drivers
# Converted from Makefile - analyzed with kernel .config
#
# Modules built:
#   - mlan.ko  (MLAN core driver)
#   - moal.ko  (MOAL Linux interface driver)
#
# Kernel config used for analysis:
#   CONFIG_64BIT=y
#   CONFIG_WIRELESS_EXT=y
#   CONFIG_WEXT_PRIV=y
#   CONFIG_CFG80211=m
#   CONFIG_PROC_FS=y
#
# Usage:
#   For imx8mp: //nxp-mwifiex:mwifiex_modules_imx8mp
#   For imx:    //nxp-mwifiex:mwifiex_modules_imx
#   Default:    //nxp-mwifiex:mwifiex_modules (alias to imx8mp)

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load(":mwifiex.bzl", "define_mwifiex")

package(default_visibility = ["//visibility:public"])

# =============================================================================
# Headers
# =============================================================================

ddk_headers(
    name = "mwifiex_headers",
    hdrs = glob([
        "mlan/**/*.h",
        "mlinux/**/*.h",
    ]),
    includes = [
        "mlan",
        "mlinux",
    ],
)

# =============================================================================
# Module definitions for each kernel build
# =============================================================================

define_mwifiex(
    name_suffix = "imx8mp",
    kernel_build = "//kernel_imx:imx8mp",
    kernel_headers = "//kernel_imx:all_headers_aarch64",
)

define_mwifiex(
    name_suffix = "imx",
    kernel_build = "//kernel_imx:imx",
    kernel_headers = "//kernel_imx:all_headers_aarch64",
)

define_mwifiex(
    name_suffix = "imx95",
    kernel_build = "//kernel_imx:imx95",
    kernel_headers = "//kernel_imx:all_headers_aarch64",
)

# =============================================================================
# Default aliases (for backward compatibility)
# =============================================================================

alias(
    name = "mwifiex_modules",
    actual = ":mwifiex_modules_imx8mp",
)

alias(
    name = "mlan",
    actual = ":mlan_imx8mp",
)

alias(
    name = "moal",
    actual = ":moal_imx8mp",
)
