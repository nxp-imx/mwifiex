#
# Bazel build configuration for NXP MWIFIEX WiFi drivers
#
# Modules built:
#   - mlan.ko  (MLAN core driver)
#   - moal.ko  (MOAL Linux interface driver)
#
# Usage:
#   //nxp-mwifiex:mwifiex_modules_<platform>
#   e.g. //nxp-mwifiex:mwifiex_modules_imx8mp

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load(":mwifiex.bzl", "define_mwifiex")

package(default_visibility = ["//visibility:public"])

# =============================================================================
# Headers
# =============================================================================

ddk_headers(
    name = "mwifiex_headers",
    hdrs = glob([
        "mlan/**/*.h",
        "mlinux/**/*.h",
    ]),
    includes = [
        "mlan",
        "mlinux",
    ],
)

# =============================================================================
# Module definitions for each kernel build
# All platforms share the same mlan.ko and moal.ko source/flags,
# only kernel_build differs.
# =============================================================================

_PLATFORMS = {
    "imx8mp": "//kernel_imx:imx8mp",
    "imx8q": "//kernel_imx:imx8q",
    "imx95": "//kernel_imx:imx95",
    "imx952": "//kernel_imx:imx952",
    "imx8mm": "//kernel_imx:imx8mm",
    "imx8mq": "//kernel_imx:imx8mq",
    "imx8mn": "//kernel_imx:imx8mn",
    "imx8ulp": "//kernel_imx:imx8ulp",
    "imx943": "//kernel_imx:imx943",
    "imx93": "//kernel_imx:imx93",
    "imx937": "//kernel_imx:imx937",
}

[define_mwifiex(
    name_suffix = platform,
    kernel_build = kernel,
    kernel_headers = "//kernel_imx:all_headers_aarch64",
) for platform, kernel in _PLATFORMS.items()]
